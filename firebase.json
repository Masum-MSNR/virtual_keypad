{
  "hosting": [
    {
      "site": "masum-vk",
      "public": "example/build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "virtual-keypad-docs",
      "public": "site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/logo.svg",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/standalone-mode",
          "destination": "/standalone-mode.html"
        },
        {
          "source": "/numeric-keypad-pin",
          "destination": "/numeric-keypad-pin.html"
        },
        {
          "source": "/floating-keyboard",
          "destination": "/floating-keyboard.html"
        },
        {
          "source": "/kiosk-and-pos",
          "destination": "/kiosk-and-pos.html"
        },
        {
          "source": "/android-tv",
          "destination": "/android-tv.html"
        },
        {
          "source": "/custom-layouts",
          "destination": "/custom-layouts.html"
        },
        {
          "source": "/theming",
          "destination": "/theming.html"
        },
        {
          "source": "/languages-and-rtl",
          "destination": "/languages-and-rtl.html"
        },
        {
          "source": "/emoji-keyboard",
          "destination": "/emoji-keyboard.html"
        },
        {
          "source": "/troubleshooting",
          "destination": "/troubleshooting.html"
        }
      ]
    }
  ]
}
